{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-content.mjs",
            "timeout": 30,
            "statusMessage": "Checking twin context pack"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-commit.mjs",
            "if": "Bash(git commit*)",
            "timeout": 180,
            "statusMessage": "Running tests and build before commit"
          }
        ]
      }
    ]
  }
}
