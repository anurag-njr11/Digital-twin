# Server-only. Set these in Vercel project settings; never prefix with VITE_ (N2.1).
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-latest.
GEMINI_MODEL=
# Optional. Rate limit, daily cap and anonymous logs (Upstash Redis free tier).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Required with Upstash: any long random string, used to hash IPs for rate limiting.
IP_HASH_SALT=
# Optional. Lets `npm run eval` skip the rate limit.
EVAL_TOKEN=
